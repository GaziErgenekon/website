# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# Üretimde bu değerler GitHub Actions secret'larından gelir (deploy.yml).

# EmailJS (İletişim formu)
VITE_REACT_SERVICE_ID=
VITE_REACT_TEMPLATE_ID=
VITE_REACT_PUBLIC_KEY=

# Cloudflare Web Analytics beacon token'ı.
# dash.cloudflare.com > Web Analytics > Add a site > snippet içindeki token.
# Boş bırakılırsa analytics script'i hiç eklenmez (güvenli no-op).
VITE_CF_BEACON_TOKEN=
